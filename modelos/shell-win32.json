{
  "quando": { "so": "win32" },
  "regras": [
    { "padrao": "(^|\\s)/tmp(/|\\s|$)", "achado": "/tmp", "sugestao": "$env:TEMP", "motivo": "o Windows nao tem /tmp" },
    { "padrao": "2>\\s*/dev/null", "achado": "2>/dev/null", "sugestao": "2>$null", "motivo": "o Windows nao tem /dev/null" },
    { "padrao": "(^|\\s)which(\\s|$)", "achado": "which", "sugestao": "(Get-Command nome).Source", "motivo": "which nao existe no PowerShell" },
    { "padrao": "(^|\\s)touch(\\s|$)", "achado": "touch", "sugestao": "if (-not (Test-Path arq)) { New-Item -ItemType File arq }", "motivo": "touch nao existe; New-Item -Force APAGA o conteudo do arquivo que ja existe" },
    { "padrao": "(^|\\s)head(\\s|$)", "achado": "head", "sugestao": "Get-Content arq -TotalCount N", "motivo": "head nao existe no PowerShell" },
    { "padrao": "(^|\\s)tail(\\s|$)", "achado": "tail", "sugestao": "Get-Content arq -Tail N", "motivo": "tail nao existe no PowerShell" },
    { "padrao": "<<\\s*'?[A-Za-z_]+'?", "achado": "heredoc", "sugestao": "here-string @'...'@ com o fecho '@ na coluna 0", "motivo": "o PowerShell nao tem heredoc" },
    { "padrao": "mkdir\\s+-p", "achado": "mkdir -p", "sugestao": "New-Item -ItemType Directory -Force caminho", "motivo": "-p nao e flag do PowerShell" },
    { "padrao": "\\brm\\s+-[a-zA-Z]*r", "achado": "rm -r", "sugestao": "Remove-Item -Recurse -Force", "motivo": "no PowerShell rm e o Remove-Item, que nao aceita flags do bash como -rf" },
    { "padrao": "\\bexport\\s+[A-Z_]+=", "achado": "export VAR=", "sugestao": "$env:VAR = 'valor'", "motivo": "export nao existe no PowerShell" }
  ],
  "regrasPowerShell51": [
    { "padrao": "\\s&&\\s", "achado": "&&", "sugestao": "; if ($?) { ... }", "motivo": "o PowerShell 5.1 nao tem o operador &&" },
    { "padrao": "\\s\\|\\|\\s", "achado": "||", "sugestao": "; if (-not $?) { ... }", "motivo": "o PowerShell 5.1 nao tem o operador ||" }
  ]
}
